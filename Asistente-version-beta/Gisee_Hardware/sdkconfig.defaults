# Gisee — voz de la IA en el ESP32-P4 (JC-ESP32P4-M3-DEV)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# WiFi por el C6 esclavo (ESP-Hosted, SDIO)
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=y

# Decodificadores de audio
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
